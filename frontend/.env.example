# frontend/.env로 복사해서 값을 채우세요 (frontend/.env는 gitignore 대상, PC마다 새로 생성해야 함)

# PortOne(포트원) V2 결제 — 콘솔의 결제연동 > 채널설정에서 확인 (테스트 채널로도 발급 가능)
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# PortOne V2 토스페이먼츠 채널 키 (토스페이 테스트 채널)
VITE_TOSS_CHANNEL_KEY=

# PortOne V2 KG이니시스 통합 본인인증 채널 키 (개발 테스트 채널)
VITE_INICIS_IDENTITY_CHANNEL_KEY=

# hCaptcha 사이트 키 — 로그인 폼 캡차용 (개발 모드에서는 우회되지만, 위젯 렌더링엔 필요)
VITE_HCAPTCHA_SITE_KEY=
